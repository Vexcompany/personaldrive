# Cloudflare Worker secrets (for local dev, copy to workers/api/.dev.vars)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REFRESH_TOKEN=your-google-oauth-refresh-token
GOOGLE_DRIVE_ROOT=your-google-drive-root-folder-id
JWT_SECRET=replace-with-openssl-rand-hex-64

# Set MOCK_DRIVE=true ONLY for local testing without Google Drive credentials
# MOCK_DRIVE=true

# Next.js frontend (copy to apps/web/.env.local)
# Leave unset in local dev to proxy /api/* to http://127.0.0.1:8787 automatically,
# or set to your deployed Cloudflare Worker URL in production:
NEXT_PUBLIC_API_URL=http://127.0.0.1:8787
